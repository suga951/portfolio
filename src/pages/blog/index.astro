---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site.config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const kb = (b?: string) => `${(new TextEncoder().encode(b ?? '').length / 1024).toFixed(1)}K`;
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title={`Blog — ${site.name}`} description={`Notes on backend development by ${site.name}.`}>
  <section class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
    <SectionHeading cmd="ls -l ~/blog" title="Blog" as="h1" />
    <p class="-mt-4 mb-10 text-lg text-muted">Notes on NestJS, AWS, Linux and backend engineering.</p>
    <ul class="grid gap-4">
      {posts.map((p) => (
        <li>
          <a href={`${base}/blog/${p.id}/`} class="card group block">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
              <span class="hidden sm:inline" aria-hidden="true">-rw-r--r-- {site.name.toLowerCase()} {kb(p.body)}</span>
              <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
              <span class="text-accent-2" aria-hidden="true">{p.id}.md</span>
              {p.data.draft && <span class="todo">Draft / placeholder</span>}
            </div>
            <h2 class="mt-3 text-2xl font-medium tracking-tight transition-colors duration-500 group-hover:text-accent">{p.data.title}</h2>
            <p class="mt-1.5 text-muted">{p.data.description}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">{p.data.tags.map((t) => <li class="chip">#{t}</li>)}</ul>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
