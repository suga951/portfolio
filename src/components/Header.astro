---
import { site } from '../site.config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/#about`, label: 'about' },
  { href: `${base}/#skills`, label: 'skills' },
  { href: `${base}/#projects`, label: 'projects' },
  { href: `${base}/blog/`, label: 'blog' },
  { href: `${base}/#contact`, label: 'contact' },
];
---
<header class="sticky top-0 z-40 border-b border-dashed border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5 py-2.5 sm:h-16 sm:flex-nowrap sm:py-0">
    <a href={`${base}/`} class="group font-mono text-base font-bold tracking-tight text-fg">
      <span class="text-accent-2" aria-hidden="true">~/</span>{site.name.toLowerCase()}<span class="animate-blink text-accent-2" aria-hidden="true">_</span>
    </a>
    <nav aria-label="Main" class="flex w-full items-center justify-between gap-0.5 sm:gap-1 sm:w-auto sm:justify-end">
      {links.map((l) => (
        <a href={l.href} class="group rounded-full px-1 py-1.5 font-mono text-[0.74rem] whitespace-nowrap text-muted transition-colors duration-500 ease-calm hover:bg-sand hover:text-fg sm:px-2.5 sm:text-sm">
          <span class="hidden opacity-0 transition-opacity group-hover:opacity-60 group-focus-visible:opacity-60 lg:inline" aria-hidden="true">cd </span><span class="text-accent-2" aria-hidden="true">/</span>{l.label}
        </a>
      ))}
      <button
        id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme"
        class="ml-0.5 grid size-7 sm:ml-1 sm:size-8 shrink-0 cursor-pointer place-items-center rounded-full border border-line text-muted transition hover:border-accent/50 hover:text-fg"
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
