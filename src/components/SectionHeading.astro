---
interface Props { cmd: string; title: string; cwd?: string; as?: 'h1' | 'h2' }
const { cmd, title, cwd = '~', as: Tag = 'h2' } = Astro.props;
---
<div class="mb-8">
  <p class="mb-2 truncate font-mono text-xs text-muted sm:text-sm" aria-hidden="true">
    <span class="ps1">suga@dev</span><span class="text-muted">:</span><span class="text-accent-2">{cwd}</span><span class="text-muted">$</span> {cmd}
  </p>
  <Tag class="flex items-center gap-3 text-3xl font-semibold tracking-tight sm:text-4xl">
    <span class="font-mono text-accent/80" aria-hidden="true">#</span>{title}
  </Tag>
</div>
