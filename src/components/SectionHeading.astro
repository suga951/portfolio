---
interface Props { cmd: string; title: string; cwd?: string; as?: 'h1' | 'h2' }
const { cmd, title, cwd = '~', as: Tag = 'h2' } = Astro.props;
---
<div class="mb-10">
  <p class="mb-2 truncate font-mono text-xs text-muted sm:text-sm" aria-hidden="true">
    <span class="ps1">suga@dev</span><span class="text-muted">:</span><span class="text-accent-2">{cwd}</span><span class="text-muted">$</span> <span class="text-fg/80">{cmd}</span>
  </p>
  <Tag class="text-4xl font-medium tracking-tight sm:text-5xl">
    <span class="squiggle">{title}</span>
  </Tag>
</div>
